# Copy to .env and set local values. Keep real credentials out of version control.
EBROWSER_APP_NAME=EBrowserAgent
EBROWSER_ENV=development
AI_PROVIDER=anthropic
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=30
EBROWSER_RUN_TIMEOUT_SECONDS=300
EBROWSER_CLEANUP_GRACE_SECONDS=5
